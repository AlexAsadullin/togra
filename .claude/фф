## 🔧 Интеграция в CLI (`cli.py`)

```python
@app.command()
def tokens(
    path: Path = Argument(default=".", help="Path to file or directory"),
    graph: bool = Option(False, "--graph", "-g", help="Count tokens in graph.json instead of source"),
    include_comments: bool = Option(False, "--include-comments", "-c", help="Include comments in count"),
    include_strings: bool = Option(False, "--include-strings", "-s", help="Include string literals in count"),
    format: str = Option("table", "--format", "-f", help="Output format: plain, json, table"),
    lang: str = Option(None, "--lang", "-l", help="Filter by language: python,typescript"),
    verbose: bool = Option(False, "--verbose", "-v", help="Detailed output"),
):
    """
    Estimate token count for project files or generated graph.
    
    Use this to plan AI context usage and evaluate graph efficiency.
    """
    if graph:
        result = count_tokens_in_graph(
            graph_path=Path("togra-output/graph.json"),
            include_comments=include_comments,
            include_strings=include_strings,
        )
    else:
        result = count_tokens_in_directory(
            root=Path("."),
            target=path,
            include_comments=include_comments,
            include_strings=include_strings,
            lang_filter=lang.split(",") if lang else None,
        )
    
    output = format_result(result, format=format, verbose=verbose)
    print(output)
```

